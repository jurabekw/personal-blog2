{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/rss",
      "destination": "/api/index.ts"
    },
    {
      "source": "/admin",
      "destination": "/_shell.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/_shell.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/_shell.html"
    }
  }
}
