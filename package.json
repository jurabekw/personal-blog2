    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
