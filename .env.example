# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (pooled recommended)
# Example: postgresql://username:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# JWT_SECRET: Secret key for signing admin login tokens (optional, fallback provided)
JWT_SECRET="jurabek-publishing-secure-jwt-key-2026"

# ADMIN_PASSWORD: Admin login password (default: James1995.123)
ADMIN_PASSWORD="James1995.123"
