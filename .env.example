# ─────────────────────────────────────────────────────────────
# Jurabek Blog — environment variables
# Copy to .env.local for development. On Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, Vercel Postgres or any Postgres 14+).
# Use the *pooled* connection string on serverless hosts.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Long random string used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# First administrator, created automatically on the first deploy if no users exist.
# Change the password from Admin → Profile after first login.
# Changing either value later re-applies it to the main administrator on the next deploy
# (and signs out existing sessions); a password set in Profile is kept until then.
# Never commit real values — set them only in your hosting environment variables.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Public site URL (no trailing slash). Used for canonical URLs, sitemaps and OG tags.
# Can also be changed in Admin → Settings → General.
NEXT_PUBLIC_SITE_URL="https://www.jurabek.blog"

# Vercel Blob token for media uploads (added automatically when you connect a Blob store).
# Without it, uploads are saved to /public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=""

# Optional: extra image hosts allowed for next/image (comma separated), e.g. a Supabase bucket host.
IMAGE_HOSTS=""
